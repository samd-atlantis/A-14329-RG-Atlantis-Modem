#!/bin/sh
# Runs once after provisioning. Never use shared passwords in an image.
set -eu
UNIT=/etc/gateway/unit.json
if [ ! -r "$UNIT" ]; then
	passwd -l root >/dev/null 2>&1 || true
	logger -t gateway 'Missing per-unit provisioning; Wi-Fi setup not enabled'
	exit 1
fi
serial="$(jsonfilter -i "$UNIT" -e '@.serial')"
ssid="$(jsonfilter -i "$UNIT" -e '@.ssid')"
key="$(jsonfilter -i "$UNIT" -e '@.wifi_password')"
hash="$(jsonfilter -i "$UNIT" -e '@.root_hash')"
case "$serial" in ''|*[!A-Za-z0-9-]*) exit 1;; esac
[ ${#key} -ge 16 ] && [ ${#key} -le 63 ] && [ ${#ssid} -le 32 ]
case "$hash" in '$6$'*) ;; *) exit 1;; esac
# Hash is generated by the provisioning tool; no plaintext admin password on router.
awk -F: -v OFS=: -v hash="$hash" '$1 == "root" {$2=hash} {print}' /etc/shadow > /etc/shadow.gateway
chmod 600 /etc/shadow.gateway
mv /etc/shadow.gateway /etc/shadow
uci set system.@system[0].hostname="AG-$serial"
uci set gateway.main.serial="$serial"
uci set network.lan.ipaddr='192.168.50.1'
uci set network.lan.netmask='255.255.255.0'
# Retain upstream board-generated four-LAN-port switch VLAN (PHY1..4).
# Remove PHY0 wired WAN; this carrier's upstream is cellular.
uci -q delete network.wan || true
uci -q delete network.wan6 || true
uci set network.cellular=interface
uci set network.cellular.proto='qmi'
uci set network.cellular.device='/dev/cdc-wdm0'
uci set network.cellular.apn=''
uci set network.cellular.auth='none'
uci set network.cellular.pdptype='ipv4'
uci set network.cellular.auto='0'
uci set dhcp.lan.start='100'
uci set dhcp.lan.limit='100'
uci set dhcp.lan.leasetime='12h'
uci set wireless.radio0.country='US'
uci set wireless.radio0.channel='auto'
uci set wireless.radio0.htmode='HT20'
uci set wireless.radio0.disabled='0'
uci set wireless.default_radio0=wifi-iface
uci set wireless.default_radio0.device='radio0'
uci set wireless.default_radio0.mode='ap'
uci set wireless.default_radio0.network='lan'
uci set wireless.default_radio0.ssid="$ssid"
uci set wireless.default_radio0.encryption='psk2'
uci set wireless.default_radio0.key="$key"
uci set wireless.default_radio0.disabled='0'
# Standard upstream firewall has lan -> wan forwarding and WAN masquerading.
zone=''
for section in $(uci show firewall | sed -n 's/^firewall\.\([^.=]*\)=zone$/\1/p'); do
	[ "$(uci -q get "firewall.$section.name")" = 'wan' ] && zone="$section"
done
[ -n "$zone" ] || exit 1
uci -q del_list "firewall.$zone.network=cellular" || true
uci add_list "firewall.$zone.network=cellular"
uci set "firewall.$zone.input=REJECT"
uci set "firewall.$zone.forward=REJECT"
uci set "firewall.$zone.masq=1"
uci set dropbear.@dropbear[0].Interface='lan'
uci set dropbear.@dropbear[0].PasswordAuth='on'
uci set uhttpd.main.redirect_https='1'
uci commit
chmod 600 "$UNIT"
exit 0
