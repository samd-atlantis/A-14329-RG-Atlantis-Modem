#!/bin/sh
# Runs once after provisioning. Never use shared passwords in an image.
set -eu
# OpenWrt sources defaults inside an AND-list subshell. That context suppresses
# errexit even after set -e, so every required operation explicitly exits on error.
UNIT=/etc/gateway/unit.json
# UCI defaults run again after a sysupgrade. Preserve the installed site's
# credentials, APN, LAN and Wi-Fi settings after initial provisioning succeeds.
[ "$(uci -q get gateway.main.provisioned || echo 0)" != 1 ] || exit 0
fail_closed() {
	trap - EXIT
	set +e
	passwd -l root >/dev/null 2>&1 || true
	# boot commits all remaining UCI deltas after processing defaults, even when
	# one failed. Do not let a failed final commit publish a staged success marker.
	uci -q revert gateway
	uci -q delete gateway.main.provisioned
	uci -q commit gateway
	# This path is reachable only before successful provisioning. Keep the local
	# USB/UART fixture console available while root network login stays locked.
	uci -q revert system
	uci -q set system.@system[0].ttylogin='0'
	uci -q commit system
	uci -q revert wireless
	for radio in $(uci -q show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
		uci -q set "wireless.$radio.disabled=1"
	done
	uci -q commit wireless
	wifi down >/dev/null 2>&1
	logger -t gateway 'Provisioning failed; root locked and Wi-Fi disabled. Use local recovery.'
	exit 1
}
trap fail_closed EXIT
trap 'exit 1' HUP INT TERM
[ -r "$UNIT" ] || exit 1
serial="$(jsonfilter -i "$UNIT" -e '@.serial')" || exit 1
ssid="$(jsonfilter -i "$UNIT" -e '@.ssid')" || exit 1
key="$(jsonfilter -i "$UNIT" -e '@.wifi_password')" || exit 1
hash="$(jsonfilter -i "$UNIT" -e '@.root_hash')" || exit 1
case "$serial" in ''|*[!A-Za-z0-9-]*) exit 1;; esac
[ ${#serial} -le 24 ] || exit 1
# The internal HLK radio is phy0. Use its permanent MAC, also pinned below as
# the setup AP BSSID, so the advertised name matches the actual Wi-Fi address.
mac="$(cat /sys/class/ieee80211/phy0/macaddress)" || exit 1
[ ${#mac} -eq 17 ] || exit 1
printf '%s\n' "$mac" | LC_ALL=C grep -Eq '^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$' || exit 1
mac="$(printf '%s' "$mac" | tr 'a-f' 'A-F')" || exit 1
case "$mac" in 00:00:00:00:00:00|?[13579BDF]:*) exit 1;; esac
suffix="$(printf '%s' "$mac" | tr -d ':' | cut -c9-12)" || exit 1
expected_ssid="Atlantis-$suffix"
[ "$ssid" = Atlantis-AUTO ] || [ "$ssid" = "$expected_ssid" ] || exit 1
ssid="$expected_ssid"
case "$key" in *[!0-9a-f]*) exit 1;; esac
[ ${#key} -eq 24 ] || exit 1
printf '%s\n' "$hash" | LC_ALL=C grep -Eq '^\$6\$(rounds=[1-9][0-9]*\$)?[./A-Za-z0-9]{1,16}\$[./A-Za-z0-9]{86}$' || exit 1
# Find the board's WAN zone before modifying settings or enabling access.
zone=''
for section in $(uci show firewall | sed -n 's/^firewall\.\([^.=]*\)=zone$/\1/p'); do
	[ "$(uci -q get "firewall.$section.name")" = 'wan' ] && zone="$section"
done
[ -n "$zone" ] || exit 1
# Keep the root account locked until all first-boot configuration has succeeded.
passwd -l root >/dev/null 2>&1 || exit 1
# Hash is generated by the provisioning tool; no plaintext admin password on router.
awk -F: -v OFS=: -v hash="$hash" '$1 == "root" {$2=hash} {print}' /etc/shadow > /etc/shadow.gateway || exit 1
chmod 600 /etc/shadow.gateway || exit 1
uci set system.@system[0].hostname="AG-$serial" || exit 1
# Upstream defaults ttylogin=0, which bypasses the password with login -f root.
# Provisioned units must authenticate on the USB/UART console as well as LuCI.
uci set system.@system[0].ttylogin='1' || exit 1
uci set gateway.main.serial="$serial" || exit 1
uci set network.lan.ipaddr='10.0.100.7' || exit 1
uci set network.lan.netmask='255.255.254.0' || exit 1
# Retain upstream board-generated four-LAN-port switch VLAN (PHY1..4).
# Remove PHY0 wired WAN; this carrier's upstream is cellular.
uci -q delete network.wan || true
uci -q delete network.wan6 || true
uci set network.cellular=interface || exit 1
uci set network.cellular.proto='qmi' || exit 1
uci set network.cellular.device='/dev/cdc-wdm0' || exit 1
uci set network.cellular.apn='' || exit 1
uci set network.cellular.auth='none' || exit 1
uci set network.cellular.pdptype='ipv4' || exit 1
uci set network.cellular.auto='0' || exit 1
uci set dhcp.lan.start='150' || exit 1
uci set dhcp.lan.limit='50' || exit 1
uci set dhcp.lan.leasetime='12h' || exit 1
uci set wireless.radio0.country='US' || exit 1
uci set wireless.radio0.channel='auto' || exit 1
uci set wireless.radio0.htmode='HT20' || exit 1
uci set wireless.radio0.disabled='0' || exit 1
uci set wireless.default_radio0=wifi-iface || exit 1
uci set wireless.default_radio0.device='radio0' || exit 1
uci set wireless.default_radio0.mode='ap' || exit 1
uci set wireless.default_radio0.network='lan' || exit 1
uci set wireless.default_radio0.ssid="$ssid" || exit 1
uci set wireless.default_radio0.macaddr="$mac" || exit 1
uci set wireless.default_radio0.encryption='psk2' || exit 1
uci set wireless.default_radio0.key="$key" || exit 1
uci set wireless.default_radio0.disabled='0' || exit 1
# Standard upstream firewall has lan -> wan forwarding and WAN masquerading.
uci -q del_list "firewall.$zone.network=cellular" || true
uci add_list "firewall.$zone.network=cellular" || exit 1
uci set "firewall.$zone.input=REJECT" || exit 1
uci set "firewall.$zone.forward=REJECT" || exit 1
uci set "firewall.$zone.masq=1" || exit 1
uci set dropbear.@dropbear[0].Interface='lan' || exit 1
uci set dropbear.@dropbear[0].PasswordAuth='on' || exit 1
uci set uhttpd.main.redirect_https='1' || exit 1
chmod 600 "$UNIT" || exit 1
for config in system network dhcp firewall dropbear uhttpd wireless; do
	uci commit "$config" || exit 1
done
mv /etc/shadow.gateway /etc/shadow || exit 1
uci set gateway.main.provisioned='1' || exit 1
uci commit gateway || exit 1
trap - EXIT HUP INT TERM
exit 0
